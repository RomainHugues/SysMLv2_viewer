{
  "name": "celeris",
  "displayName": "Celeris",
  "description": "SysMLv2 Mermaid Viewer",
  "version": "0.3.0",
  "publisher": "CelerisViewer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RomainHugues/SysMLv2_viewer.git"
  },
  "homepage": "https://github.com/RomainHugues/SysMLv2_viewer#readme",
  "bugs": {
    "url": "https://github.com/RomainHugues/SysMLv2_viewer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "icons/icon.png",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "sysml",
        "extensions": [
          ".sysml"
        ],
        "aliases": [
          "SysML"
        ]
      }
    ],
    "commands": [
      {
        "command": "celeris.showFlowchart",
        "title": "Show Flowchart Diagram",
        "category": "Celeris"
      },
      {
        "command": "celeris.showClass",
        "title": "Show Class Diagram",
        "category": "Celeris"
      },
      {
        "command": "celeris.showState",
        "title": "Show State Diagram",
        "category": "Celeris"
      },
      {
        "command": "celeris.showSequence",
        "title": "Show Sequence Diagram",
        "category": "Celeris"
      },
      {
        "command": "celeris.showRequirement",
        "title": "Show Requirement Diagram",
        "category": "Celeris"
      },
      {
        "command": "celeris.showInterconnection",
        "title": "Show Interconnection Diagram",
        "category": "Celeris"
      },
      {
        "command": "celeris.showRealization",
        "title": "Show Realization Diagram",
        "category": "Celeris"
      },
      {
        "command": "celeris.showTable",
        "title": "Show Table…",
        "category": "Celeris"
      },
      {
        "command": "celeris.selectStyleFile",
        "title": "Select Style File…",
        "category": "Celeris"
      },
      {
        "command": "celeris.clearStyleFile",
        "title": "Clear Style File",
        "category": "Celeris"
      },
      {
        "command": "celeris.showLog",
        "title": "Show Log",
        "category": "Celeris"
      }
    ],
    "submenus": [
      {
        "id": "celeris.diagramMenu",
        "label": "Celeris"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "celeris.diagramMenu",
          "group": "navigation@9",
          "when": "resourceLangId == sysml"
        }
      ],
      "celeris.diagramMenu": [
        {
          "command": "celeris.showFlowchart",
          "when": "resourceLangId == sysml"
        },
        {
          "command": "celeris.showClass",
          "when": "resourceLangId == sysml"
        },
        {
          "command": "celeris.showState",
          "when": "resourceLangId == sysml"
        },
        {
          "command": "celeris.showSequence",
          "when": "resourceLangId == sysml"
        },
        {
          "command": "celeris.showRequirement",
          "when": "resourceLangId == sysml"
        },
        {
          "command": "celeris.showInterconnection",
          "when": "resourceLangId == sysml"
        },
        {
          "command": "celeris.showRealization",
          "when": "resourceLangId == sysml"
        },
        {
          "command": "celeris.showTable",
          "when": "resourceLangId == sysml"
        }
      ]
    },
    "configuration": {
      "title": "Celeris",
      "properties": {
        "celeris.flowchart.direction": {
          "type": "string",
          "enum": [
            "TB",
            "LR",
            "BT",
            "RL"
          ],
          "default": "TB",
          "description": "Flowchart layout direction (top-bottom, left-right, ...)."
        },
        "celeris.theme": {
          "type": "string",
          "enum": [
            "default",
            "dark",
            "forest",
            "neutral"
          ],
          "default": "default",
          "description": "Mermaid rendering theme."
        },
        "celeris.autoRefreshOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh open diagrams when their .sysml file is saved."
        },
        "celeris.styleFile": {
          "type": "string",
          "default": null,
          "markdownDescription": "Path to a JSON style file that colors diagram elements by native SysML type and/or the SysML type they conform to. Absolute, or relative to the workspace folder or the .sysml file. See `examples/arcadia/arcadia.style.json`."
        },
        "celeris.tableConfig": {
          "type": "string",
          "default": null,
          "markdownDescription": "Path to a JSON `.table.json` defining custom tabular views (each with a row `select` and `columns`). Adds to the built-in presets (Requirements, Interfaces, Elements). Absolute, or relative to the workspace folder or the .sysml file. See `examples/tables/celeris.table.json`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check-parser": "node scripts/check-parser-bundle.mjs examples/coffee.sysml",
    "vendor": "node scripts/build-vendor.mjs",
    "notices": "node scripts/gen-notices.mjs",
    "manual": "node scripts/gen-manual.mjs",
    "stress": "node scripts/gen-stress-examples.mjs",
    "load-test": "node scripts/load-test.mjs",
    "test": "vitest run",
    "package": "vsce package"
  },
  "dependencies": {
    "mermaid": "^11.15.0",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
